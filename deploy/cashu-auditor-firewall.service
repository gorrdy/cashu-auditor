[Unit]
Description=Cashu Audit: only the reverse proxy may reach the app port
Before=cashu-auditor.service
After=network-pre.target
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
EnvironmentFile=/etc/cashu-auditor/env
ExecStart=/bin/sh -c 'iptables -t raw -C PREROUTING -p tcp -d ${BIND_HOST} --dport ${PORT} ! -s ${PROXY_IP} ! -i lo -j DROP 2>/dev/null || iptables -t raw -I PREROUTING -p tcp -d ${BIND_HOST} --dport ${PORT} ! -s ${PROXY_IP} ! -i lo -j DROP'
ExecStop=/bin/sh -c 'iptables -t raw -D PREROUTING -p tcp -d ${BIND_HOST} --dport ${PORT} ! -s ${PROXY_IP} ! -i lo -j DROP 2>/dev/null || true'

[Install]
WantedBy=multi-user.target
