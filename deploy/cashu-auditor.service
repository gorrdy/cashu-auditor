[Unit]
Description=Cashu Mints Auditor (cashu.info)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=cashu-audit
Group=cashu-audit
WorkingDirectory=/srv/cashu-auditor/app
EnvironmentFile=/etc/cashu-auditor/env
Environment=NODE_ENV=production
Environment=HOME=/srv/cashu-auditor
ExecStart=/opt/node-v24.21.0/bin/node node_modules/next/dist/bin/next start -H ${BIND_HOST} -p ${PORT}
Restart=always
RestartSec=5
SuccessExitStatus=143
TimeoutStopSec=15
UMask=0077
MemoryMax=1G
TasksMax=256

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/cashu-auditor/data /srv/cashu-auditor/app/.next/cache
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
